{
  "name": "@nareyko/mcp-yacht-specs",
  "version": "1.0.1",
  "description": "MCP server for FairHelm public yacht passport specs, hydrodynamic coefficients, and survey/formula pointers (read-only).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-yacht-specs": "dist/index.js",
    "fairhelm-mcp-yacht-specs": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "data",
    "openapi",
    "README.md",
    "LICENSE",
    "server.json",
    "glama.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
    "build:snapshot": "node scripts/build-snapshot.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "lint:deslop": "node ../../scripts/lint-packages-deslop.mjs",
    "smoke": "node scripts/smoke-tools.mjs",
    "test": "npm run lint:deslop && npm run smoke",
    "prepublishOnly": "npm run lint:deslop && npm run build:snapshot && npm run build && npm run smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nareyko/mcp-yacht-specs.git"
  },
  "bugs": {
    "url": "https://github.com/nareyko/mcp-yacht-specs/issues"
  },
  "homepage": "https://fairhelm.com/en/yachts/formulas/",
  "keywords": [
    "mcp",
    "fairhelm",
    "yacht",
    "sailboat",
    "survey",
    "openapi",
    "zero-network"
  ]
}
